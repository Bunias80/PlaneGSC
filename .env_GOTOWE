# --- DATABASE SETTINGS ---
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_DB=plane
PGDATA=/var/lib/postgresql/data
DATABASE_URL=postgres://plane:plane@plane-db:5432/plane

# --- REDIS SETTINGS ---
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/0

# --- RABBITMQ SETTINGS ---
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane
RABBITMQ_VHOST=plane

# --- GENERAL SETTINGS ---
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443
SECRET_KEY=plane-pms-2026-secure-key
LIVE_SERVER_SECRET_KEY=plane-live-secret-2026
DOCKERIZED=1
DEBUG=1

# --- URL SETTINGS (Internal) ---
API_BASE_URL=http://api:8000
WEB_URL=http://localhost
SPACE_URL=http://space:3000
ADMIN_URL=http://admin:3000

# --- PUBLIC URL SETTINGS ---
NEXT_PUBLIC_API_BASE_URL=http://localhost/api
NEXT_PUBLIC_WEB_URL=http://localhost

# --- AUTHENTICATION ---
ENABLE_EMAIL_PASSWORD=1
ENABLE_MAGIC_LINK=1

# --- STORAGE ---
USE_MINIO=1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880
GUNICORN_WORKERS=1